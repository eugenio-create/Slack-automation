# Existing integration
BITRIX_WEBHOOK=https://SEU-PORTAL.bitrix24.com.br/rest/USUARIO/TOKEN/
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SELF_BASE_URL=https://slack-automation-vnr8-ashy.vercel.app
NOTIF_SECRET=
SLACK_CANAL_NOTIFICACOES=

# New per-owner notifications: disabled until configured and reviewed.
NOVOS_LEADS_ENABLED=false
NOVOS_LEADS_SECRET=
# Optional: internal STATUS_ID. If omitted, a unique matching stage name is required.
NOVOS_LEADS_STATUS_ID=
# baseline = ignore cards already in the stage on first run; all = include them.
NOVOS_LEADS_INITIAL_MODE=baseline
# Optional comma-separated field codes from crm.lead.fields (replaces default fields).
NOVOS_LEADS_FORM_FIELDS=
# Persistent delivery receipts / distributed lock. No form values are stored here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only for the optional external Node worker (not a Vercel function).
NOVOS_LEADS_URL=https://slack-automation-vnr8-ashy.vercel.app/api/notificar-novos-leads
